+def quote_score(text, rx):
+    """How clearly the comment recommends the tool: a strong cue right next to the name scores highest."""
+    best = 0
+    for m in rx.finditer(text):
+        win = text[max(0, m.start() - 60): m.end() + 60]
+        if STRONG.search(win):
+            best = max(best, 2)
+        elif CUE.search(win):
+            best = max(best, 1)
+    return best
+
